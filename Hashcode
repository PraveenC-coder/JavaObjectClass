package com.jspider.ObjectClass;


class Person1{
	int age = 21;
}
class Person2{
	int age = 22;
	
	@Override
	public int hashCode() {
		return age;
	}
}
public class hashCode {
	public static void main (String [] args) {
		
		Person1 p1= new Person1();
		System.out.println(p1.hashCode());
		
		Person2 p2= new Person2();
		System.out.println(p2.hashCode());	}
}
